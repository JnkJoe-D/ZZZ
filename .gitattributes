Assets/**/*.[oO][bB][jJ] filter=lfs diff=lfs merge=lfs -text
Assets/**/*.[pP][nN][gG] filter=lfs diff=lfs merge=lfs -text
Assets/**/*.[jJ][pP][gG] filter=lfs diff=lfs merge=lfs -text
Assets/**/*.[jJ][pP][eE][gG] filter=lfs diff=lfs merge=lfs -text
Assets/**/*.[tT][gG][aA] filter=lfs diff=lfs merge=lfs -text
Assets/**/*.[pP][sS][dD] filter=lfs diff=lfs merge=lfs -text
Assets/**/*.[tT][iI][fF] filter=lfs diff=lfs merge=lfs -text
Assets/**/*.[tT][iI][fF][fF] filter=lfs diff=lfs merge=lfs -text
Assets/**/*.[eE][xX][rR] filter=lfs diff=lfs merge=lfs -text
Assets/**/*.[hH][dD][rR] filter=lfs diff=lfs merge=lfs -text
Assets/**/*.[wW][aA][vV] filter=lfs diff=lfs merge=lfs -text
