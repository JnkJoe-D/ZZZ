.transition-root {
    flex-direction: row;
    flex-grow: 1;
    background-color: #1e1e22;
    color: #e0e0e0;
    font-size: 12px;
}

.transition-sidebar {
    width: 320px;
    min-width: 260px;
    max-width: 400px;
    background-color: #25252a;
    border-right-width: 1px;
    border-right-color: #161618;
    padding: 8px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
}

.sidebar-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: #4da6ff;
    margin-bottom: 8px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: #38383e;
}

.section-box {
    background-color: #2c2c32;
    border-radius: 4px;
    padding: 6px;
    margin-bottom: 6px;
    border-width: 1px;
    border-color: #36363d;
}

.section-header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}

.section-label {
    font-size: 11px;
    -unity-font-style: bold;
    color: #a0a0a8;
}

.mini-btn {
    height: 18px;
    font-size: 10px;
    padding-left: 6px;
    padding-right: 6px;
    border-radius: 3px;
    background-color: #383842;
    border-width: 1px;
    border-color: #4a4a56;
    color: #cfd3dc;
}

.mini-btn:hover {
    background-color: #444452;
    color: #ffffff;
}

.popup-container {
    width: 100%;
}

.targets-box {
    flex-grow: 1;
    min-height: 120px;
    display: flex;
    flex-direction: column;
    margin-bottom: 0;
}

.targets-search {
    width: auto;
    margin-bottom: 4px;
}

.target-list-view {
    flex-grow: 1;
    min-height: 90px;
    background-color: #202024;
    border-radius: 4px;
    border-width: 1px;
    border-color: #333338;
}

.target-item {
    flex-direction: row;
    align-items: center;
    padding: 5px 8px;
    border-bottom-width: 1px;
    border-bottom-color: #28282e;
    cursor: link;
}

.target-item:hover {
    background-color: #303038;
}

.target-item-selected {
    background-color: #2d4560;
    border-left-width: 3px;
    border-left-color: #4da6ff;
}

.badge {
    padding: 1px 5px;
    border-radius: 3px;
    font-size: 9px;
    -unity-font-style: bold;
    margin-right: 6px;
    color: #ffffff;
}

.badge-route {
    background-color: #2e669e;
}

.badge-loop {
    background-color: #9c6b24;
}

.badge-complete {
    background-color: #3b7a57;
}

.target-name {
    flex-grow: 1;
    color: #ffffff;
    -unity-font-style: bold;
}

.target-fade-summary {
    color: #8fa0b0;
    font-size: 10px;
}

/* ──────────────── 主区域与视口容器 ──────────────── */

.transition-main {
    flex-grow: 1;
    flex-direction: column;
    background-color: #1a1a1c;
}

.viewport-wrapper {
    flex-grow: 1;
    position: relative;
    overflow: hidden;
    min-height: 250px;
    background-color: #121214;
}

.viewport-container {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

/* ──────────────── Blender 风格 N-Panel 侧边收纳工具栏 ──────────────── */

.npanel-container {
    position: absolute;
    top: 6px;
    right: 0px;
    bottom: 6px;
    flex-direction: row;
    align-items: stretch;
}

.npanel-content {
    width: 320px;
    max-height: 100%;
    background-color: rgba(30, 30, 36, 0.94);
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
    border-left-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: #3e3e4a;
    padding: 8px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.npanel-tabs-strip {
    width: 26px;
    background-color: #1b1b1e;
    border-left-width: 1px;
    border-left-color: #323238;
    align-items: center;
    padding-top: 6px;
}

.npanel-tab-btn {
    width: 22px;
    min-height: 80px;
    padding: 6px 2px;
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
    background-color: #272730;
    color: #b0b4c0;
    font-size: 11px;
    -unity-font-style: bold;
    white-space: normal;
    text-align: middle-center;
    border-width: 1px;
    border-color: #3a3a46;
    border-right-width: 0;
    cursor: link;
}

.npanel-tab-btn:hover {
    background-color: #343440;
    color: #ffffff;
}

.npanel-tab-btn.active {
    background-color: #2563eb;
    color: #ffffff;
    border-color: #3b82f6;
}

/* ──────────────── Inspector 微调面板内部控件 ──────────────── */

.inspector-box {
    background-color: transparent;
    padding: 0;
    margin-bottom: 0;
    display: flex;
    flex-direction: column;
}

.inspector-header-label {
    font-size: 11px;
    -unity-font-style: bold;
    color: #4da6ff;
    margin-bottom: 6px;
    overflow: hidden;
    text-overflow: ellipsis;
}

.inspector-field-group {
    margin-bottom: 6px;
}

.inspector-label-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2px;
}

.inspector-field-title {
    font-size: 11px;
    color: #b0b0b8;
    -unity-font-style: bold;
}

.inspector-control-row {
    flex-direction: row;
    align-items: center;
    overflow: hidden;
}

.inspector-slider {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 60px;
    margin-right: 4px;
}

.inspector-num-field {
    flex-shrink: 0;
    width: 52px;
    min-width: 52px;
}

.unit-dropdown-container {
    width: 84px;
    height: 18px;
    flex-shrink: 0;
}

.unit-dropdown-container .unity-base-popup-field {
    height: 18px;
    margin: 0;
    font-size: 10px;
}

.unit-dropdown-container .unity-base-popup-field__text {
    font-size: 10px;
}

.slider-strip-row {
    margin-top: 2px;
    align-items: center;
}

.mini-track-slider {
    flex-grow: 1;
    height: 22px;
    margin-right: 6px;
}

.unit-aligned-field {
    width: 84px;
    min-width: 84px;
    flex-shrink: 0;
    margin-right: 0;
}

.autoroute-sync-group {
    margin-top: 6px;
    padding: 6px;
    background-color: #1e1e23;
    border-radius: 4px;
    border-width: 1px;
    border-color: #33333d;
}

.autoroute-popup-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 4px;
}

.autoroute-popup-label {
    font-size: 10px;
    color: #9aa0a6;
    width: 65px;
    flex-shrink: 0;
}

.autoroute-popup {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 80px;
    height: 20px;
}

.inspector-toggle {
    font-size: 11px;
    color: #b0b0b8;
    -unity-font-style: bold;
}

.save-button {
    background-color: #2b6cb0;
    color: #ffffff;
    -unity-font-style: bold;
    border-radius: 4px;
    height: 26px;
    margin-top: 6px;
}

.save-button:hover {
    background-color: #3b82f6;
}

/* ──────────────── 播放控制条与时间轴 ──────────────── */

.playback-toolbar {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    min-height: 32px;
    background-color: #28282e;
    padding: 3px 8px;
    border-top-width: 1px;
    border-top-color: #333338;
    border-bottom-width: 1px;
    border-bottom-color: #333338;
}

.toolbar-btn {
    height: 22px;
    margin-right: 4px;
    padding-left: 8px;
    padding-right: 8px;
}

.toolbar-menu-btn {
    height: 22px;
    padding-left: 7px;
    padding-right: 7px;
    background-color: #34343b;
    border-width: 1px;
    border-color: #484854;
    border-radius: 3px;
    color: #e0e0e0;
    margin-left: 4px;
    font-size: 11px;
    -unity-font-style: bold;
}

.toolbar-menu-btn:hover {
    background-color: #40404a;
    border-color: #5c5c6c;
    color: #ffffff;
}

.time-label {
    margin-left: 8px;
    color: #b0c4de;
    font-size: 11px;
}

.toolbar-toggle {
    margin-left: 8px;
    font-size: 11px;
}

.timeline-container {
    height: 140px;
    background-color: #18181a;
}
