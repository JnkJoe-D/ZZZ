# Standard Unity .gitignore
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Bb]undles/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# IDE & Editor cache directories
.vs/
.gradle/
.idea/
.vscode/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# PIDB files for Video
/[Aa]ssets/[Ss]treamingAssets/*.pidb

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt
crashlytics-build.properties

# Builds
*.apk
*.aab
*.unitypackage
*.app
*.ipa
*.exe

# Files generated by Visual Studio / Rider / Monodevelop
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# Unity3D generated file
*.map

# AI & Agent Workspace Artifacts
.gemini/
.antigravity/
.ai-config/
.agent/
# Keep shared rules, skills and workflows; ignore other local Agent state.
/.agents/*
!/.agents/rules/
!/.agents/skills/
!/.agents/workflows/
/.agents/**/__pycache__/
/.agents/**/*.pyc
/.agents/**/.cache/

# Unused / unsorted art: keep local copies, exclude assets and their folder meta.
/Assets/RawArtAssets/Animation/Role/Anbi/
/Assets/RawArtAssets/Animation/Role/Anbi.meta
/Assets/RawArtAssets/Animation/Role/Anby/
/Assets/RawArtAssets/Animation/Role/Anby.meta
/Assets/RawArtAssets/Animation/Role/Unagi/
/Assets/RawArtAssets/Animation/Role/Unagi.meta
/Assets/RawArtAssets/Model/Avatar_Female_Size02_Unagi_Model/
/Assets/RawArtAssets/Model/Avatar_Female_Size02_Unagi_Model.meta
/Assets/Resources/Models/安比/
/Assets/Resources/Models/安比.meta
/Assets/Resources/Models/星见雅/
/Assets/Resources/Models/星见雅.meta
/Assets/Resources/Animations/Clips/安比/
/Assets/Resources/Animations/Clips/安比.meta
/Assets/Resources/Audio/AnBi/
/Assets/Resources/Audio/AnBi.meta
/Assets/Resources/Prefab/Role/Anbi/
/Assets/Resources/Prefab/Role/Anbi.meta
/Assets/Resources/Prefab/Role/Unagi/
/Assets/Resources/Prefab/Role/Unagi.meta
/Assets/Resources/Particles/Lightning VFX/
/Assets/Resources/Particles/Lightning VFX.meta
/Assets/Resources/Particles/VFX_Klaus/
/Assets/Resources/Particles/VFX_Klaus.meta
/Assets/RawArtAssets/VFX/Fire/
/Assets/RawArtAssets/VFX/Fire.meta

